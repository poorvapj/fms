{
  "name": "fms-operations-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/env.ts local src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/env.ts local src/index.ts",
    "start:live": "node --disable-warning=ExperimentalWarning src/env.ts live src/index.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/env.ts local src/db/seed.ts",
    "seed:live": "node --disable-warning=ExperimentalWarning src/env.ts live src/db/seed.ts",
    "import:cli": "node --disable-warning=ExperimentalWarning src/env.ts local src/import/cli.ts",
    "import:cli:live": "node --disable-warning=ExperimentalWarning src/env.ts live src/import/cli.ts",
    "copy-live-to-local": "node --disable-warning=ExperimentalWarning src/tools/copyLiveToLocal.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/e2e.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
