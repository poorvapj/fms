# Copy to .env.local (testing) and .env.live (real data) and fill in. Those files are git-ignored.
# Each environment should use its own MongoDB cluster or at least its own database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<name>
MONGODB_DB=fms_local

# Optional
# PORT=4600                     (default: Local 4600, Live 4700; Render sets PORT itself)
# JWT_SECRET=long-random-string (default: generated and stored in data/<env>/.jwt-secret)
# ADMIN_PASSWORD=...            (first "admin" login, only when the database has no users)
# FRONTEND_URL=https://...      TRUST_PROXY=2   SECURE_COOKIES=true   COOKIE_SAMESITE=lax
